class UrlExtract
  include Enumerable[Match]

  VERSION: String

  TRIM: Array[String]

  MAX_SIZE: Integer

  DEFAULTS: Hash[Symbol, untyped]

  class EncodingError < ArgumentError
  end

  def self.matches: (String text, **untyped options) -> UrlExtract

  def self.urls: (String text, **untyped options) -> Array[String]

  def initialize: (String text, **untyped options) -> void

  def each: () { (Match match) -> void } -> self
          | () -> Enumerator[Match, self]

  class Match
    attr_reader url: String

    attr_reader index: Integer

    attr_reader text: String

    def initialize: (String url, Integer index, String text) -> void

    def range: () -> Range[Integer]

    def ==: (untyped other) -> bool
  end
end
